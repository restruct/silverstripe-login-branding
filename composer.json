{
  "name": "restruct/silverstripe-login-branding",
  "description": "Admin login form (de-)branding module",
  "type": "silverstripe-vendormodule",
  "keywords": [ "silverstripe" ],
  "license": "MIT",
  "authors": [ { "name": "Restruct", "email": "dev@restruct.nl", "homepage": "https://restruct.nl" } ],
  "require": {
      "php": "^8.1",
      "silverstripe/framework": "^5 || ^6",
      "silverstripe/login-forms": "^5 || ^6",
      "silverstripe/vendor-plugin": "^2 || ^3"
  },
  "require-dev": {
      "silverstripe/recipe-testing": "^3 || ^4"
  },
  "suggest": {
      "silverstripe/siteconfig": "Enables the SiteConfigBrandingExtension: LeftAndMain.application_name as the admin site name",
      "restruct/silverstripe-favicons": "Generates favicon, touch icon and web manifest variants from one PNG, for the login pages, the CMS and the site"
  },
  "autoload": {
    "psr-4": {
        "Restruct\\SilverStripe\\AdminBranding\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
        "Restruct\\LoginBranding\\Tests\\": "tests/"
    }
  },
  "extra": {
    "expose": [
      "client"
    ]
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ]
}
